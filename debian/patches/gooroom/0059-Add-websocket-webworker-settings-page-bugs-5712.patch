+++ b/gooroom/browser/gooroom_pref.h
@@ -30,7 +30,7 @@ class GooroomPref {
   GooroomPref();
   ~GooroomPref();
 
-//  PrefService* pref();
+  std::unique_ptr<PrefService> getPref();
   GooroomUrlFilterImpl* setMainpref();
   void setup();
 
