From 1d6fe1e22b1cf1e76f29fd8bccdffe2a9a6d7d2e Mon Sep 17 00:00:00 2001
From: junsungc <junsungc@gooroom.kr>
Date: Wed, 8 Jun 2022 14:59:24 +0900
Subject: [PATCH 51/58] Fix dynamic PageSourceViewEnabled value

---
 .../policy/core/browser/configuration_policy_handler.cc  | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/components/policy/core/browser/configuration_policy_handler.cc b/components/policy/core/browser/configuration_policy_handler.cc
index 03389475d9010..9ab3c658d88f5 100644
--- a/components/policy/core/browser/configuration_policy_handler.cc
+++ b/components/policy/core/browser/configuration_policy_handler.cc
@@ -407,9 +407,14 @@ void PageSourceViewPolicyHandler::ProcessPolicy(const policy::PolicyMap& policie
                                         const std::string& policy,
                                         bool disable_pdf_plugin,
                                         ContentSetting flash_content_setting) {
-  if(policies.GetValueUnsafe(policy::key::kPageSourceViewEnabled))
-    if(!policies.GetValueUnsafe(policy::key::kPageSourceViewEnabled)->GetBool())
+  if(policies.GetValueUnsafe(policy::key::kPageSourceViewEnabled)) {
+    if(!policies.GetValueUnsafe(policy::key::kPageSourceViewEnabled)->GetBool()) {
       PageSourceViewPolicyHandler::enabled = false;
+    } else {
+      PageSourceViewPolicyHandler::enabled = true;
+    }
+  }
+
   return;
 }
 
