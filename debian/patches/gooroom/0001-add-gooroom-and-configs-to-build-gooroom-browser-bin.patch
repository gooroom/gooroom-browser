+content::ContentBrowserClient*
+GooroomMainDelegate::CreateContentBrowserClient() {
+  chrome_content_browser_client_ =
+      std::make_unique<GooroomContentBrowserClient>();
+  return chrome_content_browser_client_.get();
+}
