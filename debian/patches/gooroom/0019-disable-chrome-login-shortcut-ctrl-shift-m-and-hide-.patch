From f95d3369252ef027efd49a1e33bb0a620577db97 Mon Sep 17 00:00:00 2001
From: junsungc <junsungc@gooroom.kr>
Date: Thu, 23 Jul 2020 17:23:10 +0900
Subject: [PATCH 19/63] disable chrome login shortcut(ctrl+shift+m) and hide
 login icon

---
 chrome/browser/ui/browser_command_controller.cc | 3 +++
 chrome/browser/ui/views/toolbar/toolbar_view.cc | 4 ++++
 2 files changed, 7 insertions(+)

Index: chromium-149-deb12/chrome/browser/ui/browser_command_controller.cc
===================================================================
--- chromium-149-deb12.orig/chrome/browser/ui/browser_command_controller.cc
+++ chromium-149-deb12/chrome/browser/ui/browser_command_controller.cc
@@ -880,9 +880,11 @@ bool BrowserCommandController::ExecuteCo
           signin_metrics::AccessPoint::kMenu);
       break;
     case IDC_SHOW_SIGNIN_WHEN_PAUSED:
+#if !defined(GOOROOM_BUILD)
       signin_ui_util::ShowReauthForPrimaryAccountWithAuthError(
           browser_->profile(), signin_metrics::AccessPoint::kMenu);
       break;
+#endif
     case IDC_SHOW_PASSWORD_MANAGER:
       ShowPasswordManager(browser_);
       break;
Index: chromium-149-deb12/chrome/browser/ui/views/toolbar/toolbar_view.cc
===================================================================
--- chromium-149-deb12.orig/chrome/browser/ui/views/toolbar/toolbar_view.cc
+++ chromium-149-deb12/chrome/browser/ui/views/toolbar/toolbar_view.cc
@@ -593,6 +593,10 @@ void ToolbarView::Init() {
                                  browser_->profile()->IsGuestSession() ||
                                  browser_->profile()->IsRegularProfile();
 #endif
+#if defined(GOOROOM_BUILD)
+    //Hide show_avatar_toolbar_button
+    show_avatar_toolbar_button = false;
+#endif
     avatar_->SetVisible(show_avatar_toolbar_button);
   }
 
