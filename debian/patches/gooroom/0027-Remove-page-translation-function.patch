     // languages, so the current full page target language may not be
     // supported.
-    if (CanPartiallyTranslateTargetLanguage()) {
-      AppendPartialTranslateItem();
-    } else {
-      AppendTranslateItem();
-    }
   }
 #endif  // !BUILDFLAG(IS_CHROMEOS)
 
