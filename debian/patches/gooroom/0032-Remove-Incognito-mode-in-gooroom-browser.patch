From 465c2d26d8ae05968bf7e3d9ba0e731c663347a4 Mon Sep 17 00:00:00 2001
From: junsungc <junsungc@gooroom.kr>
Date: Mon, 27 Jul 2020 12:00:59 +0900
Subject: [PATCH 32/63] Remove Incognito mode in gooroom-browser

---
 chrome/browser/ui/browser_command_controller.cc | 2 ++
 1 file changed, 2 insertions(+)

Index: gooroom-browser-debian.git/chrome/browser/ui/browser_command_controller.cc
===================================================================
--- gooroom-browser-debian.git.orig/chrome/browser/ui/browser_command_controller.cc
+++ gooroom-browser-debian.git/chrome/browser/ui/browser_command_controller.cc
@@ -641,10 +641,14 @@ bool BrowserCommandController::ExecuteCo
       NewWindow(browser_);
       break;
     case IDC_NEW_INCOGNITO_WINDOW:
+#if !defined(GOOROOM_BUILD)
       NewIncognitoWindow(profile());
+#endif
       break;
     case IDC_NEW_ISOLATED_WINDOW:
+#if !defined(GOOROOM_BUILD)
       NewIncognitoWindow(profile());
+#endif
       break;
     case IDC_CLOSE_WINDOW:
       base::RecordAction(base::UserMetricsAction("CloseWindowByKey"));
