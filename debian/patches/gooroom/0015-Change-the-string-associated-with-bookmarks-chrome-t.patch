From d399751608882fe7d844bd81c87bd78def184a5c Mon Sep 17 00:00:00 2001
From: junsungc <junsungc@gooroom.kr>
Date: Thu, 23 Jul 2020 17:11:36 +0900
Subject: [PATCH 15/63] Change the string associated with bookmarks (chrome://
 to gooroom://)

---
 .../ui/views/bookmarks/bookmark_bar_view.cc     | 10 ++++++++++
 .../ui/views/bookmarks/bookmark_editor_view.cc  | 17 +++++++++++++++++
 2 files changed, 27 insertions(+)

Index: gooroom-browser-debian.git/chrome/browser/ui/views/bookmarks/bookmark_bar_view.cc
===================================================================
--- gooroom-browser-debian.git.orig/chrome/browser/ui/views/bookmarks/bookmark_bar_view.cc
+++ gooroom-browser-debian.git/chrome/browser/ui/views/bookmarks/bookmark_bar_view.cc
@@ -664,6 +664,16 @@ std::u16string BookmarkBarView::CreateTo
     elided_url = base::i18n::GetDisplayStringInLTRDirectionality(elided_url);
     result.append(elided_url);
   }
+
+//Change bookmark tooltip strings. (chrome:// -> gooroom://)
+#if defined(GOOROOM_BUILD)
+    std::string chrometooltip;
+    chrometooltip = base::UTF16ToUTF8(result);
+    if (chrometooltip.find("chrome://") != std::string::npos)
+      chrometooltip.replace(chrometooltip.find("chrome://"),6,"gooroom");
+    result = base::UTF8ToUTF16(chrometooltip);
+#endif
+
   return result;
 }
 
Index: gooroom-browser-debian.git/chrome/browser/ui/views/bookmarks/bookmark_editor_view.cc
===================================================================
--- gooroom-browser-debian.git.orig/chrome/browser/ui/views/bookmarks/bookmark_editor_view.cc
+++ gooroom-browser-debian.git/chrome/browser/ui/views/bookmarks/bookmark_editor_view.cc
@@ -554,7 +554,17 @@ void BookmarkEditorView::AddLabels() {
     labels->AddChildView(std::make_unique<views::Label>(
         l10n_util::GetStringUTF16(IDS_BOOKMARK_EDITOR_URL_LABEL)));
     url_tf_ = labels->AddChildView(std::make_unique<views::Textfield>());
+//Change bookmark on 'more..' popup page strings (chrome:// to gooroom://)
+#if defined(GOOROOM_BUILD)
+    if (url.scheme() == "chrome") {
+      std::string gooroom_scheme = "gooroom://" + url.GetContent();
+      url_tf_->SetText(base::UTF8ToUTF16(gooroom_scheme));
+    } else {
+      url_tf_->SetText(chrome::FormatBookmarkURLForDisplay(url));
+    }
+#else
     url_tf_->SetText(chrome::FormatBookmarkURLForDisplay(url));
+#endif
     url_tf_->set_controller(this);
     url_tf_->GetViewAccessibility().SetName(
         l10n_util::GetStringUTF16(IDS_BOOKMARK_AX_EDITOR_URL_LABEL));
@@ -695,6 +705,13 @@ void BookmarkEditorView::ApplyEdits(Edit
   GURL new_url(GetInputURL());
   std::u16string new_title(title_tf_ ? title_tf_->GetText() : u"");
 
+//When the bookmark is applied, change the string (gooroom:// to chrome://)
+#if defined(GOOROOM_BUILD)
+  if (new_url.scheme() == "gooroom") {
+    new_url = GURL("chrome://" + new_url.GetContent());
+  }
+#endif
+
   if (!show_tree_) {
     BookmarkEditor::ApplyEdits(bb_model_, details_.parent_node, details_,
                                new_title, new_url);
