   [[maybe_unused]] base::CommandLine* command_line(
       base::CommandLine::ForCurrentProcess());
 
+  // Capture the unpolluted command line snapshot, exactly where upstream
+  // ChromeMain() does. chrome://policy reads it through
+  // GetInitialBrowserCommandLine(); without this the optional stays empty and
+  // the browser aborts with bad_optional_access when that page is opened.
+  if (!command_line->HasSwitch(switches::kProcessType))
+    SetInitialBrowserCommandLine(*command_line);
