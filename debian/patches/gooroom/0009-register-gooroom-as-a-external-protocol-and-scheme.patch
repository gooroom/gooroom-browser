From 0f1e854ce36275348e7e2c862560870db5ef7cc4 Mon Sep 17 00:00:00 2001
From: junsungc <junsungc@gooroom.kr>
Date: Thu, 23 Jul 2020 14:59:35 +0900
Subject: [PATCH 09/63] register /gooroom/ as a external protocol and scheme

---
 chrome/browser/profiles/profile_io_data.cc | 4 ++++
 content/common/url_schemes.cc              | 4 ++++
 content/public/common/url_constants.h      | 1 +
 3 files changed, 9 insertions(+)

Index: gooroom-browser-debian.git/chrome/browser/profiles/profile_io_data.cc
===================================================================
--- gooroom-browser-debian.git.orig/chrome/browser/profiles/profile_io_data.cc
+++ gooroom-browser-debian.git/chrome/browser/profiles/profile_io_data.cc
@@ -44,6 +44,10 @@ bool ProfileIOData::IsHandledProtocol(st
       extensions::kExtensionScheme,
 #endif
       content::kChromeUIScheme,
+#if defined(GOOROOM_BUILD)
+      // Treat "gooroom://" as a external protocol
+      content::kGooroomUIScheme,
+#endif
       content::kChromeUIUntrustedScheme,
       url::kDataScheme,
 #if BUILDFLAG(IS_CHROMEOS)
Index: gooroom-browser-debian.git/content/common/url_schemes.cc
===================================================================
--- gooroom-browser-debian.git.orig/content/common/url_schemes.cc
+++ gooroom-browser-debian.git/content/common/url_schemes.cc
@@ -60,6 +60,10 @@ void RegisterContentSchemes(bool should_
 
   url::AddStandardScheme(kChromeDevToolsScheme, url::SCHEME_WITH_HOST);
   url::AddStandardScheme(kChromeUIScheme, url::SCHEME_WITH_HOST);
+  // Slightly tint string "gooroom://" viewed in location bar.
+#if defined(GOOROOM_BUILD)
+  url::AddStandardScheme(kGooroomUIScheme, url::SCHEME_WITH_HOST);
+#endif
   url::AddStandardScheme(kChromeUIUntrustedScheme, url::SCHEME_WITH_HOST);
   url::AddStandardScheme(kChromeErrorScheme, url::SCHEME_WITH_HOST);
   for (auto& scheme : schemes.standard_schemes)
Index: gooroom-browser-debian.git/content/public/common/url_constants.h
===================================================================
--- gooroom-browser-debian.git.orig/content/public/common/url_constants.h
+++ gooroom-browser-debian.git/content/public/common/url_constants.h
@@ -18,6 +18,7 @@ namespace content {
 // from there.
 inline constexpr char kChromeDevToolsScheme[] = "devtools";
 inline constexpr char kChromeErrorScheme[] = "chrome-error";
+inline constexpr char kGooroomUIScheme[] = "gooroom"; // Used for WebUIs.
 inline constexpr char kChromeUIScheme[] = "chrome";  // Used for WebUIs.
 inline constexpr char kChromeNativeScheme[] = "chrome-native";
 inline constexpr char kChromeUIUntrustedScheme[] = "chrome-untrusted";
