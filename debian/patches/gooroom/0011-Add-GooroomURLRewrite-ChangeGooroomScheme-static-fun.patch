--- gooroom-browser-debian.git.orig/gooroom/URLRewrite/gooroom_url_rewrite.cc
+++ gooroom-browser-debian.git/gooroom/URLRewrite/gooroom_url_rewrite.cc
@@ -8,6 +8,16 @@
 #include "content/public/common/url_constants.h"
 #include "ui/base/l10n/l10n_util.h"
 
+GURL GooroomURLRewrite::ChangeGooroomScheme(GURL url){
+  // Change "chrome://" to "gooroom://"
+  if(url.scheme() == "chrome"){
+    std::string new_url = "gooroom://" + url.GetContent();
+    GURL changed_url = GURL(new_url);
+    return changed_url;
+  }
+  return url;
+}
+
