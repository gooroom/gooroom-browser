From 46dfec94c6e1c267da2b0411168a3755ec6f20e9 Mon Sep 17 00:00:00 2001
From: junsungc <junsungc@gooroom.kr>
Date: Wed, 22 Jul 2020 15:33:29 +0900
Subject: [PATCH 07/63] disable prerender

---
 chrome/browser/ui/omnibox/chrome_omnibox_client.cc | 2 ++
 1 file changed, 2 insertions(+)

Index: gooroom-browser-debian.git/chrome/browser/ui/omnibox/chrome_omnibox_client.cc
===================================================================
--- gooroom-browser-debian.git.orig/chrome/browser/ui/omnibox/chrome_omnibox_client.cc
+++ gooroom-browser-debian.git/chrome/browser/ui/omnibox/chrome_omnibox_client.cc
@@ -760,10 +760,12 @@ void ChromeOmniboxClient::OnTextChanged(
         break;
       }
       // Ask for prerendering if the destination URL is different than the
+#if !defined(GOOROOM_BUILD)
       // current URL.
       if (current_match.destination_url != GetURL()) {
         DoPrerender(current_match);
       }
+#endif
       break;
     case AutocompleteActionPredictor::ACTION_PRECONNECT:
       DoPreconnect(current_match);
