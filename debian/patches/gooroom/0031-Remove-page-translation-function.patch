Subject: [PATCH 31/65] * Remove page-translation function.

---
 .../browser/renderer_context_menu/render_view_context_menu.cc  | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/chrome/browser/renderer_context_menu/render_view_context_menu.cc b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
index 216e16410ba43..5160137b274ea 100644
--- a/chrome/browser/renderer_context_menu/render_view_context_menu.cc
+++ b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
@@ -1954,6 +1954,8 @@ void RenderViewContextMenu::AppendPageItems() {
   if (has_sharing_menu_items)
     menu_model_.AddSeparator(ui::NORMAL_SEPARATOR);
 
+//Gooroom-browser unsupport Page-translation
+#if !defined(GOOROOM_BUILD)
   if (CanTranslate(/*menu_logging=*/true)) {
     menu_model_.AddItem(
         IDC_CONTENT_CONTEXT_TRANSLATE,
@@ -1961,6 +1963,7 @@ void RenderViewContextMenu::AppendPageItems() {
             IDS_CONTENT_CONTEXT_TRANSLATE,
             GetTargetLanguageDisplayName(/*is_full_page_translation=*/true)));
   }
+#endif
 }
 
 void RenderViewContextMenu::AppendExitFullscreenItem() {
