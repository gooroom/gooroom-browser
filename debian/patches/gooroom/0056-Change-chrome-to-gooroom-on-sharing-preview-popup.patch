From 3971ae84bb3049c723a15a78aa1ceb65cf165b41 Mon Sep 17 00:00:00 2001
From: cjs <cjs@hancom.com>
Date: Thu, 31 Aug 2023 02:04:45 -0400
Subject: [PATCH 56/58] Change chrome to gooroom on sharing preview popup

---
 chrome/browser/ui/views/sharing_hub/preview_view.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/ui/views/sharing_hub/preview_view.cc b/chrome/browser/ui/views/sharing_hub/preview_view.cc
index 4ec3d44af706a..5df218340327a 100644
--- a/chrome/browser/ui/views/sharing_hub/preview_view.cc
+++ b/chrome/browser/ui/views/sharing_hub/preview_view.cc
@@ -14,6 +14,7 @@
 #include "ui/views/layout/flex_layout.h"
 #include "ui/views/layout/flex_layout_types.h"
 #include "ui/views/view_class_properties.h"
+#include "gooroom/URLRewrite/gooroom_url_rewrite.h"
 
 namespace sharing_hub {
 
@@ -104,7 +105,7 @@ PreviewView::PreviewView(share::ShareAttempt attempt) {
   title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
 
   url_ = labels_container->AddChildView(std::make_unique<UrlLabel>(
-      attempt.url, views::style::CONTEXT_DIALOG_BODY_TEXT,
+      GooroomURLRewrite::ChangeGooroomScheme(attempt.url), views::style::CONTEXT_DIALOG_BODY_TEXT,
       views::style::STYLE_HINT));
   url_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
 }
